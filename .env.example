# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados do seu projeto Supabase.
# O arquivo .env NÃO vai para o Git.
# Supabase: Project Settings > Database (ou botão "Connect" no topo do painel).

# Opção 1 - conexão direta (precisa de rede com IPv6)
DB_URL=jdbc:postgresql://db.SEU_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=SUA_SENHA_DO_BANCO

# Opção 2 - Session pooler (funciona em redes só IPv4; use a porta 5432, não a 6543).
# Copie o host exato que aparece em "Connect > Session pooler".
# DB_URL=jdbc:postgresql://aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USER=postgres.SEU_PROJECT_REF
