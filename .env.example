# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados do seu projeto Supabase.
# O arquivo .env NÃO vai para o Git.
#
# No Supabase: Project Settings > Database > Connection string > JDBC > "Session pooler"
# (o Session pooler funciona em redes IPv4; use a porta 5432, não a 6543).
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO
